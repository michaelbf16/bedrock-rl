+/* [bedrock-rl] ---- the derived half of the journal ------------------
+ *
+ * Some transitions have an obvious place in the engine to emit from, and
+ * those carry an rlj_emit() call at that place. Inventory does not. There
+ * is no single chokepoint: writes reach the player inventory through
+ * isr_set_stack, through isr_decr_stack_size's raw slot pointer, through
+ * isr_pick_item, and through four whole-struct `player.inv = next`
+ * assignments, and hooking the setter alone would miss about half of
+ * them, silently.
+ *
+ * So inventory is journalled by DIFF instead, once per tick, over the
+ * unified container_live slot-id space. That is complete by construction:
+ * it cannot miss a write, and a future engine change that moves items
+ * some new way needs no new hook. What it gives up is intra-tick
+ * ordering, so two changes to one slot within a tick coalesce into the
+ * net change. No action in this environment moves a slot twice in a tick
+ * (one gui_click per tick is the rule), and order ACROSS ticks, which is
+ * what the ordering predicate reads, is exact.
+ *
+ * The same argument applies to the open screen, the hotbar selection and
+ * the vitals, which are cheap reads with many writers, so they are
+ * diffed here too.
+ *
+ * Slot ids match game/container_live.h and bedrock_rl/gui_layout.py:
+ *   0..35   player inventory (0..8 hotbar, 9..35 main)
+ *   36..44  craft matrix, row-major
+ *   49..52  armor
+ * Slot 45, the craft RESULT, is deliberately absent: it is a recipe
+ * preview computed from the matrix rather than storage, so it would emit
+ * a change every time the grid moved and mean nothing extra. Taking the
+ * result is RLJ_ITEM_CRAFTED. */
+#define RLJ_SLOT_N 49            /* 45 inventory+matrix, then 4 armor */
+
+static int rlj_slot_prev[RLJ_SLOT_N][3];
+/* Byte copies of the two containers the slot pass reads, so the common
+ * tick can answer "did anything move" with two memcmp calls instead of
+ * 49 stack reads and 147 comparisons. Nothing moves on the overwhelming
+ * majority of ticks: an episode touches its inventory on the handful of
+ * ticks that carry a click or a pickup. Padding, if these structs have
+ * any, can only make a memcmp report a difference that the slot pass
+ * then finds nothing in, which costs one scan and emits nothing. It
+ * cannot hide a change, because equal bytes are equal slots. */
+static IsrInv rlj_inv_prev;
+static ICStack rlj_grid_prev[9];
+static int rlj_cursor_prev[3];
+static int rlj_screen_prev, rlj_sx_prev, rlj_sy_prev, rlj_sz_prev;
+static int rlj_hotbar_prev;
+static int rlj_dead_prev, rlj_dimension_prev;
+static int rlj_click_prev[5];
+static int rlj_bucket_prev[6];
+static int rlj_fluid_prev, rlj_fluid_flags_prev;
+static int rlj_state_valid;      /* 0 = take a baseline, do not emit */
+
+static int rlj_slot_id(int i)
+{
+    return i < 45 ? i : GMC_ARMOR0 + (i - 45);
+}
+
+static void rlj_stack_of(const GmRuntime *r, int i, int *out)
+{
+    ICStack s;
+    if (i < 36)      s = isr_get_stack(&r->player.inv, i);
+    else if (i < 45) s = r->craft_grid[i - 36];
+    else             s = isr_get_stack(&r->player.inv, ISR_ARMOR0 + (i - 45));
+    if (s.item <= 0 || s.count <= 0) {
+        out[0] = 0; out[1] = 0; out[2] = 0;
+    } else {
+        out[0] = s.item; out[1] = s.count; out[2] = s.meta;
+    }
+}
+
+/* Fluid contact must be sampled every engine tick rather than reconstructed
+ * from the top-256 nearby-block list at an assistant-turn boundary. BODY is
+ * the exact volume predicate used by player physics. VIEWPOINT and OVERLAY
+ * come from the same evaluator as frame_capture.c, so red lava fog or the
+ * water overlay cannot appear without a corresponding journal state. The
+ * first dry sample is emitted too: an artifact with no event is an old,
+ * incapable engine, not proof that the player stayed dry. */
+static void rlj_sample_fluid(const GmRuntime *r)
+{
+    GmPlayerView view;
+    GmUnderwater uw;
+    int body, block, flags = 0;
+    int x, y, z;
+
+    body = psv_in_liquid(r->window, &r->player.ent, 1) ? 8 :
+           psv_in_liquid(r->window, &r->player.ent, 0) ? 10 : 0;
+    gm_runtime_view(r, &view);
+    /* fog brightness does not participate in fluid/overlay classification. */
+    gm_uw_eval(r->world, r->dimension, &view, 1.0f, &uw);
+    if (body)
+        flags |= RLJ_FLUID_BODY;
+    if (uw.fluid)
+        flags |= RLJ_FLUID_VIEWPOINT;
+    if (uw.overlay)
+        flags |= RLJ_FLUID_OVERLAY;
+    block = (body == 10 || uw.fluid == 2) ? 10 :
+            (body == 8 || uw.fluid == 1 || uw.overlay) ? 8 : 0;
+    x = (int)floor(r->player.ent.posX + (double)r->ox);
+    y = (int)floor(r->player.ent.posY);
+    z = (int)floor(r->player.ent.posZ + (double)r->oz);
+    if (!rlj_state_valid || block != rlj_fluid_prev ||
+        flags != rlj_fluid_flags_prev)
+        rlj_emit_flags(RLJ_PLAYER_FLUID_STATE, flags,
+                       block, x, y, z,
+                       rlj_state_valid ? rlj_fluid_prev : -1,
+                       rlj_state_valid ? rlj_fluid_flags_prev : 0);
+    rlj_fluid_prev = block;
+    rlj_fluid_flags_prev = flags;
+}
+
+/* One pass. Called once per emitted observation, after the tick, with the
+ * screen state the RL loop owns. `screen` is the open container kind
+ * (0 player, 1 table, 2 furnace, 3 chest) or -1 for no screen. */
+static void rlj_sample_state(const GmRuntime *r, int screen,
+                             int sx, int sy, int sz)
+{
+    int i, cur[3];
+    ICStack cs;
+    int hot, dead;
+
+    /* The whole pass, not just the emits. A process with no journal fd
+     * must not pay for a diff nobody reads, and the journal is armed
+     * once at boot and never mid-process, so a stale latch here cannot
+     * be observed. */
+    if (!rlj_enabled)
+        return;
+
+    if (!rlj_state_valid ||
+        memcmp(&rlj_inv_prev, &r->player.inv, sizeof rlj_inv_prev) != 0 ||
+        memcmp(rlj_grid_prev, r->craft_grid, sizeof rlj_grid_prev) != 0) {
+        for (i = 0; i < RLJ_SLOT_N; ++i) {
+            rlj_stack_of(r, i, cur);
+            if (rlj_state_valid &&
+                (cur[0] != rlj_slot_prev[i][0] ||
+                 cur[1] != rlj_slot_prev[i][1] ||
+                 cur[2] != rlj_slot_prev[i][2]))
+                rlj_emit(RLJ_SLOT_CHANGED, rlj_slot_id(i), cur[0], cur[1],
+                         rlj_slot_prev[i][0], rlj_slot_prev[i][1], cur[2]);
+            rlj_slot_prev[i][0] = cur[0];
+            rlj_slot_prev[i][1] = cur[1];
+            rlj_slot_prev[i][2] = cur[2];
+        }
+        rlj_inv_prev = r->player.inv;
+        memcpy(rlj_grid_prev, r->craft_grid, sizeof rlj_grid_prev);
+    }
+
+    cs = gm_player_cursor();
+    cur[0] = (cs.item <= 0 || cs.count <= 0) ? 0 : cs.item;
+    cur[1] = cur[0] ? cs.count : 0;
+    cur[2] = cur[0] ? cs.meta : 0;
+    if (rlj_state_valid &&
+        (cur[0] != rlj_cursor_prev[0] || cur[1] != rlj_cursor_prev[1] ||
+         cur[2] != rlj_cursor_prev[2]))
+        rlj_emit(RLJ_CURSOR_CHANGED, cur[0], cur[1], cur[2],
+                 rlj_cursor_prev[0], rlj_cursor_prev[1], 0);
+    rlj_cursor_prev[0] = cur[0];
+    rlj_cursor_prev[1] = cur[1];
+    rlj_cursor_prev[2] = cur[2];
+
+    /* A switch from one container to another is a close and an open, in
+     * that order, which is what the agent did and what a task means. */
+    if (rlj_state_valid && screen != rlj_screen_prev) {
+        if (rlj_screen_prev >= 0)
+            rlj_emit(RLJ_CONTAINER_CLOSED, rlj_screen_prev, rlj_sx_prev,
+                     rlj_sy_prev, rlj_sz_prev, 0, 0);
+        if (screen >= 0)
+            rlj_emit(RLJ_CONTAINER_OPENED, screen, sx, sy, sz, 0, 0);
+    }
+    rlj_screen_prev = screen;
+    rlj_sx_prev = sx; rlj_sy_prev = sy; rlj_sz_prev = sz;
+
+    hot = r->player.inv.current_item;
+    if (rlj_state_valid && hot != rlj_hotbar_prev) {
+        ICStack h = isr_get_stack(&r->player.inv, hot);
+        rlj_emit(RLJ_HOTBAR_SELECTED, hot,
+                 (h.item > 0 && h.count > 0) ? h.item : 0, 0,
+                 rlj_hotbar_prev, 0, 0);
+    }
+    rlj_hotbar_prev = hot;
+
+    /* Health is reported as whole hearts-worth of points, 0..20, which is
+     * the number the player sees and the number a task means. */
+    rlj_sample_vitals((int)r->vitals.health, (int)r->vitals.foodLevel);
+
+    dead = r->dead ? 1 : 0;
+    if (rlj_state_valid && dead && !rlj_dead_prev)
+        rlj_emit(RLJ_DIED, 0, 0, 0, 0, 0, 0);
+    rlj_dead_prev = dead;
+
+    if (rlj_state_valid && r->dimension != rlj_dimension_prev)
+        rlj_emit(RLJ_DIMENSION_CHANGED, r->dimension,
+                 rlj_dimension_prev, 0, 0, 0, 0);
+    rlj_dimension_prev = r->dimension;
+
+    /* The exact 5-block look-axis ray used by attack/use. Unlike the
+     * bounded nearby-block summary, this cannot lose a target when flat
+     * terrain fills that summary's 256 rows. */
+    {
+        int hx, hy, hz, ax, ay, az, target[5] = {0, 0, 0, 0, 0};
+        if (gm_raycast_sel_reach(r->window, &r->sin_table, &r->player, 5.0,
+                                 &hx, &hy, &hz, &ax, &ay, &az) >= 0) {
+            target[0] = psv_get_block(r->window, hx, hy, hz);
+            target[1] = hx + r->ox;
+            target[2] = hy;
+            target[3] = hz + r->oz;
+            /* Adjacent replaceable cell selected by the exact use ray.
+             * 1 west, 2 east, 3 down, 4 up, 5 north, 6 south. The face is
+             * part of the edge latch: moving around the same hit block
+             * must still publish a fresh placement target. */
+            target[4] = ax < hx ? 1 : ax > hx ? 2
+                      : ay < hy ? 3 : ay > hy ? 4
+                      : az < hz ? 5 : az > hz ? 6 : 0;
+        }
+        if (!rlj_state_valid ||
+            memcmp(target, rlj_click_prev, sizeof target) != 0) {
+            rlj_emit_flags(RLJ_CLICK_TARGET, target[4], target[0], target[1],
+                           target[2], target[3],
+                           rlj_state_valid ? rlj_click_prev[0] : -1, 0);
+            memcpy(rlj_click_prev, target, sizeof target);
+        }
+    }
+
+    /* ItemBucket uses a different ray from attack/place: source-level fluids
+     * are hits and ordinary click_target intentionally passes through them.
+     * Publish that exact ray only for a selected empty bucket. The inactive
+     * slot=-1 state and the no-source state at the selected slot are distinct,
+     * so switching away cannot leave a stale actionable target. */
+    {
+        GmBucketTarget sampled;
+        int bucket[6];
+        gm_player_bucket_target_state(r->window, &r->sin_table, &r->player,
+                                      r->ox, r->oz, &sampled);
+        bucket[0] = sampled.block;
+        bucket[1] = sampled.wx;
+        bucket[2] = sampled.wy;
+        bucket[3] = sampled.wz;
+        bucket[4] = sampled.meta;
+        bucket[5] = sampled.slot;
+        if (!rlj_state_valid ||
+            memcmp(bucket, rlj_bucket_prev, sizeof bucket) != 0) {
+            rlj_emit(RLJ_BUCKET_TARGET,
+                     bucket[0], bucket[1], bucket[2], bucket[3],
+                     bucket[4], bucket[5]);
+            memcpy(rlj_bucket_prev, bucket, sizeof bucket);
+        }
+    }
+
+    rlj_sample_path(r->player.ent.posX + (double)r->ox,
+                    r->player.ent.posZ + (double)r->oz);
+    rlj_sample_fluid(r);
+
+    rlj_state_valid = 1;
+}
+
 int gm_rl_run(const GmConfig *cfg) {
     static GmRuntime r;
     char err[256];
@@ -882,6 +1168,16 @@ int gm_rl_run(const GmConfig *cfg) {
      * world would change what "use" does for existing non-GUI tasks. */
     r.use_activates_container = rl_gui_enabled();

+    /* [bedrock-rl] --set set_time=<ticks>: pin the world clock. A fresh
+     * world starts at tick 0, which is sunrise, and the sky light ramps to
+     * full daylight only by tick ~730, so every short episode and every
+     * recording is lit at about 0.6 of daylight. app/game_main.c already
+     * applies this knob, but only on the headless dump path, and RL mode
+     * returns at game_main.c:476 before reaching it. Applied here at boot,
+     * after gm_runtime_init. Nothing in RlBinObs samples light, so this
+     * changes rendered pixels and not the semantic observation. */
+    rl_apply_set_time(&r);
+
     /* MAGMA_RANDTICK=0: disable live random block ticks (grass spread,
      * leaf decay, fire, crops). The batched blaze env does not simulate
      * randtick, so the verify_cpu gates run the real env with this set to
@@ -913,6 +1209,14 @@ int gm_rl_run(const GmConfig *cfg) {
         }
     }

+    /* [bedrock-rl] Arm the journal from MAGMA_JOURNAL_FD, then take the
+     * baseline. Inventory and vitals do not emit transitions for initial
+     * state; exact click-target and fluid state do emit explicit baselines so
+     * an artifact can prove its engine supported those safety signals.
+     * RLJ_EPISODE marks the stream's single episode. */
+    rlj_open();
+    rlj_emit(RLJ_EPISODE, 0, 0, 0, 0, 0, 0);
+    rlj_sample_state(&r, -1, 0, 0, 0);
     rl_emit_obs(&r, cfg->rl_bin, 1);
     for (t = 0; cfg->ticks < 0 || t < cfg->ticks; ++t) {
         GmAction a;
@@ -1069,6 +1373,22 @@ int gm_rl_run(const GmConfig *cfg) {
                 gm_screen_rl_pointer = 0;
             }
         }
+        /* [bedrock-rl] journal: the diffed half of this tick. Placed
+         * after the container-follow block above, because the open screen
+         * is part of what it reports and that block is where the screen
+         * settles for this tick. Everything the engine emitted from
+         * inside the tick is already buffered ahead of these records, so
+         * one tick's records read engine transitions first, then the
+         * derived ones. rl_emit_obs flushes them. */
+        {
+            int screen;
+            if (rl_gui_enabled())
+                screen = gui_open ? r.container : -1;
+            else
+                screen = r.container ? r.container : -1;
+            rlj_sample_state(&r, screen, r.container_wx, r.container_wy,
+                             r.container_wz);
+        }
         rl_emit_obs(&r, cfg->rl_bin, (int)rl_num(line, "cam", 1));
