diff --git a/magma/game/rl_journal.c b/magma/game/rl_journal.c
new file mode 100644
index 0000000..fe308d3
--- /dev/null
+++ b/magma/game/rl_journal.c
@@ -0,0 +1,220 @@
+/* [bedrock-rl] game/rl_journal.c - buffer, stamp and write the event
+ * journal. See game/rl_journal.h for what the journal is and how to add
+ * an event type.
+ *
+ * The channel is a file descriptor named by MAGMA_JOURNAL_FD, and it is
+ * deliberately NOT stdout. stdout carries RlBinObs, whose bytes are
+ * frozen and checked, and whose reader resynchronises on a four-byte
+ * magic; a journal record that happened to contain those four bytes
+ * would be parsed as an observation. Unset the variable and every
+ * function here is a predicate test that writes nothing, which is the
+ * default for every process that does not ask for a journal.
+ *
+ * Records for one tick are buffered and written as a SINGLE write() at
+ * the tick boundary, before that tick's observation. The harness reads
+ * the observation and then drains this fd, so a reader that has just
+ * read observation N already has every record for tick N. That ordering
+ * is the whole synchronisation protocol; there is no other handshake.
+ */
+#include <errno.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "game/rl_journal.h"
+
+int rlj_enabled = 0;
+
+static int rlj_fd = -1;
+static RlJrnRec rlj_buf[RLJ_MAX_PER_TICK];
+static int rlj_n;
+static int rlj_dropped;
+
+/* per-episode latches for the edge-triggered samplers */
+static int rlj_aim_block = -1;
+static int rlj_aim_valid;
+static double rlj_path;            /* accumulated horizontal path, blocks */
+static double rlj_px, rlj_pz;
+static int rlj_path_valid;
+static long long rlj_path_whole;
+static int rlj_health = -1, rlj_food = -1;
+static int rlj_vitals_valid;
+
+static void rlj_init_latches(void)
+{
+    rlj_n = 0;
+    rlj_dropped = 0;
+    rlj_aim_block = -1;
+    rlj_aim_valid = 0;
+    rlj_path = 0.0;
+    rlj_path_whole = 0;
+    rlj_path_valid = 0;
+    rlj_px = rlj_pz = 0.0;
+    rlj_health = rlj_food = -1;
+    rlj_vitals_valid = 0;
+}
+
+void rlj_emit_flags_(int type, unsigned flags,
+                     int a, int b, int c, int d, int e, int f)
+{
+    RlJrnRec *rec;
+    if (rlj_n >= RLJ_MAX_PER_TICK) {
+        ++rlj_dropped;
+        return;
+    }
+    rec = &rlj_buf[rlj_n++];
+    rec->type = (unsigned short)type;
+    rec->flags = (unsigned short)flags;
+    rec->tick = 0;                 /* stamped in rlj_flush */
+    rec->v[0] = a; rec->v[1] = b; rec->v[2] = c;
+    rec->v[3] = d; rec->v[4] = e; rec->v[5] = f;
+}
+
+void rlj_emit_(int type, int a, int b, int c, int d, int e, int f)
+{
+    rlj_emit_flags_(type, 0, a, b, c, d, e, f);
+}
+
+static int rlj_write_all(const void *p, size_t n)
+{
+    const char *b = (const char *)p;
+    while (n > 0) {
+        ssize_t w = write(rlj_fd, b, n);
+        if (w < 0) {
+            if (errno == EINTR)
+                continue;
+            /* The reader is gone or the fd is unusable. Stop trying
+             * rather than take the simulation down with it: the journal
+             * is an observation channel and must never be able to end an
+             * episode that would otherwise have run. */
+            rlj_enabled = 0;
+            rlj_fd = -1;
+            return 0;
+        }
+        b += w;
+        n -= (size_t)w;
+    }
+    return 1;
+}
+
+void rlj_open(void)
+{
+    const char *e = getenv("MAGMA_JOURNAL_FD");
+    RlJrnHead h;
+    char *end;
+    long fd;
+
+    rlj_enabled = 0;
+    rlj_fd = -1;
+    rlj_init_latches();
+    if (!e || !*e)
+        return;
+    fd = strtol(e, &end, 10);
+    if (*end || fd < 0 || fd > 1 << 20)
+        return;
+    rlj_fd = (int)fd;
+    rlj_enabled = 1;
+    h.magic = RLJ_MAGIC;
+    h.version = RLJ_VERSION;
+    h.rec_bytes = (unsigned short)sizeof(RlJrnRec);
+    (void)rlj_write_all(&h, sizeof h);
+}
+
+void rlj_flush(int tick)
+{
+    int i;
+    if (!rlj_enabled) {
+        rlj_n = 0;
+        rlj_dropped = 0;
+        return;
+    }
+    if (rlj_dropped) {
+        /* Never silent. The cap exists so one pathological tick cannot
+         * fill the pipe and deadlock the engine against the harness, and
+         * a task whose reward depended on a dropped record must be able
+         * to see that it did. */
+        rlj_buf[RLJ_MAX_PER_TICK - 1].type = RLJ_OVERFLOW;
+        rlj_buf[RLJ_MAX_PER_TICK - 1].flags = 0;
+        rlj_buf[RLJ_MAX_PER_TICK - 1].v[0] = rlj_dropped;
+        rlj_buf[RLJ_MAX_PER_TICK - 1].v[1] = 0;
+        rlj_buf[RLJ_MAX_PER_TICK - 1].v[2] = 0;
+        rlj_buf[RLJ_MAX_PER_TICK - 1].v[3] = 0;
+        rlj_buf[RLJ_MAX_PER_TICK - 1].v[4] = 0;
+        rlj_buf[RLJ_MAX_PER_TICK - 1].v[5] = 0;
+        rlj_dropped = 0;
+    }
+    if (rlj_n <= 0)
+        return;
+    for (i = 0; i < rlj_n; ++i)
+        rlj_buf[i].tick = tick;
+    (void)rlj_write_all(rlj_buf, (size_t)rlj_n * sizeof rlj_buf[0]);
+    rlj_n = 0;
+}
+
+/* ---- edge-triggered samplers --------------------------------------- */
+
+void rlj_sample_aim(int block, int dist_q4)
+{
+    int was = rlj_aim_valid ? rlj_aim_block : -1;
+    if (!rlj_enabled)
+        return;
+    if (rlj_aim_valid && block == rlj_aim_block)
+        return;
+    rlj_aim_block = block;
+    rlj_aim_valid = 1;
+    rlj_emit(RLJ_AIMED_AT, block, dist_q4, 0, was, 0, 0);
+}
+
+/* Horizontal PATH length, accumulated per tick, which is what makes it a
+ * distance travelled rather than a displacement from the start. An agent
+ * that walks out and back has a displacement of zero and a path of
+ * twice the trip.
+ *
+ * An event per tick would not be sparse, so this fires only when the
+ * accumulated path crosses a whole block. A check therefore reads the
+ * distance floored to whole blocks, which never over-reports.
+ *
+ * The accumulation is plain double arithmetic over a deterministic
+ * sequence of positions, and the engine builds with -ffp-contract=off,
+ * so a replay reproduces the same sum bit for bit. */
+void rlj_sample_path(double wx, double wz)
+{
+    double dx, dz;
+    if (!rlj_path_valid) {
+        rlj_px = wx;
+        rlj_pz = wz;
+        rlj_path_valid = 1;
+        return;
+    }
+    dx = wx - rlj_px;
+    dz = wz - rlj_pz;
+    rlj_px = wx;
+    rlj_pz = wz;
+    rlj_path += sqrt(dx * dx + dz * dz);
+    while ((double)(rlj_path_whole + 1) <= rlj_path) {
+        ++rlj_path_whole;
+        rlj_emit(RLJ_TRAVELLED, (int)rlj_path_whole,
+                 (int)(rlj_path * 1000.0), 0, 0, 0, 0);
+    }
+}
+
+/* Unlike the aim sampler, this does NOT report its baseline. Full health
+ * at the start of an episode is a starting condition and not something
+ * that happened, and a task shaping on "took damage" would otherwise
+ * fire on tick zero of every episode. The aim sampler does report its
+ * first value, because "the crosshair was on a log" is true at t0 in the
+ * same sense it is true later, and a check for it should not depend on
+ * the agent having panned away and back. */
+void rlj_sample_vitals(int health, int food)
+{
+    int wh = rlj_health, wf = rlj_food;
+    int first = !rlj_vitals_valid;
+    if (!first && health == rlj_health && food == rlj_food)
+        return;
+    rlj_vitals_valid = 1;
+    rlj_health = health;
+    rlj_food = food;
+    if (!first)
+        rlj_emit(RLJ_VITALS_CHANGED, health, food, 0, wh, wf, 0);
+}
diff --git a/magma/game/rl_journal.h b/magma/game/rl_journal.h
new file mode 100644
index 0000000..66c0176
--- /dev/null
+++ b/magma/game/rl_journal.h
@@ -0,0 +1,171 @@
+/* [bedrock-rl] game/rl_journal.h - the typed event journal.
+ *
+ * WHY THIS EXISTS. The observation record (RlBinObs) is a SNAPSHOT. A
+ * snapshot can say "the inventory holds a crafting table"; it cannot say
+ * whether that table was crafted, picked up off the ground, taken from a
+ * chest, or restored with the start state. It also cannot express order,
+ * so "mined a log and THEN crafted planks from it" is not a question a
+ * snapshot answers. The journal is the missing half: a sequence of typed
+ * state transitions, stamped with the tick they happened on, in the order
+ * the engine performed them.
+ *
+ * WHAT IT IS NOT. It is not a state dump. Every record here is edge
+ * triggered, so a tick on which nothing happens costs one predicate test
+ * and writes nothing at all. Two of the records look per-tick and are
+ * not: RLJ_AIMED_AT fires when the block under the crosshair CHANGES, and
+ * RLJ_TRAVELLED fires when the accumulated path length crosses a whole
+ * block.
+ *
+ * THE CHANNEL. Records go to their own file descriptor, named by
+ * MAGMA_JOURNAL_FD, and never to stdout. RlBinObs is byte-frozen and
+ * several things depend on that, so the journal is not allowed to share
+ * the stream that carries it. The Python decoder and event schema live in
+ * bedrock_rl/env/journal.py.
+ *
+ * DETERMINISM. Every field of every record is a function of the world and
+ * the action sequence. Nothing here reads a clock, a frame, or anything
+ * a rendering-disabled environment does not do. That is a hard requirement, not
+ * a nice property: reward is computed by replaying a trajectory frameless
+ * through the same episode class, so a journal that did not regenerate
+ * identically would make the trainer score a trajectory differently from
+ * the episode that earned it.
+ *
+ * ---------------------------------------------------------------------
+ * ADDING AN EVENT TYPE
+ * ---------------------------------------------------------------------
+ * 1. Add a row to the enum below, with its six payload slot names in the
+ *    comment. That comment is the payload contract.
+ * 2. Call rlj_emit() at the place in the engine where the transition
+ *    happens.
+ * 3. Add the matching row to bedrock_rl/journal.py::EVENTS.
+ * Task authors then use it from YAML with no further Python.
+ *
+ * The payload is six untyped int slots rather than a struct per event.
+ * That costs compile-time checking on this side and buys a decoder and a
+ * check factory on the Python side that are uniform, so an event type is
+ * a table row in both files instead of a new code path in either.
+ */
+#ifndef MAGMA_GAME_RL_JOURNAL_H
+#define MAGMA_GAME_RL_JOURNAL_H
+
+/* ---- THE EVENT TABLE ----------------------------------------------
+ * Slot names below are the contract bedrock_rl/journal.py::EVENTS
+ * repeats. Unused slots are written as 0.
+ *
+ *                              a          b        c        d          e        f      */
+enum {
+    RLJ_EPISODE          =  1, /* index,    0,       0,       0,         0,       0     */
+    RLJ_BLOCK_BROKEN     =  2, /* block,    x,       y,       z,         tool,    drop; flags=meta */
+    RLJ_BLOCK_PLACED     =  3, /* block,    x,       y,       z,         item,    slot  */
+    RLJ_ITEM_PICKED_UP   =  4, /* item,     count,   meta,    x,         y,       z     */
+    RLJ_ITEM_DROPPED     =  5, /* item,     count,   meta,    cause,     0,       0     */
+    RLJ_ITEM_CRAFTED     =  6, /* item,     count,   meta,    width,     screen,  0     */
+    RLJ_ITEM_SMELTED     =  7, /* item,     count,   meta,    input,     0,       0     */
+    RLJ_CONTAINER_OPENED =  8, /* kind,     x,       y,       z,         0,       0     */
+    RLJ_CONTAINER_CLOSED =  9, /* kind,     x,       y,       z,         0,       0     */
+    RLJ_SLOT_CHANGED     = 10, /* slot,     item,    count,   was_item,  was_n,   0     */
+    RLJ_CURSOR_CHANGED   = 11, /* item,     count,   meta,    was_item,  was_n,   0     */
+    RLJ_HOTBAR_SELECTED  = 12, /* slot,     item,    0,       was_slot,  0,       0     */
+    RLJ_AIMED_AT         = 13, /* block,    dist_q4, 0,       was_block, 0,       0     */
+    RLJ_TRAVELLED        = 14, /* blocks,   mm,      0,       0,         0,       0     */
+    RLJ_VITALS_CHANGED   = 15, /* health,   food,    0,       was_health,was_food,0     */
+    RLJ_DIED             = 16, /* 0,        0,       0,       0,         0,       0     */
+    RLJ_DIMENSION_CHANGED= 17, /* dimension,was_dim, 0,       0,         0,       0     */
+    RLJ_CLICK_TARGET     = 18, /* block,    x,       y,       z,         was_block,0; flags=face */
+    RLJ_PLAYER_FLUID_STATE=19, /* block,    x,       y,       z,         was_block,was_flags */
+    RLJ_BUCKET_TARGET    = 20, /* block,    x,       y,       z,         meta,    slot  */
+    RLJ_OVERFLOW         = 63  /* dropped,  0,       0,       0,         0,       0     */
+};
+
+/* RLJ_ITEM_DROPPED cause slot. */
+enum { RLJ_DROP_HARVEST = 0, RLJ_DROP_TOSS = 1, RLJ_DROP_CONTAINER = 2 };
+
+/* RLJ_ITEM_CRAFTED screen slot: which surface produced it. */
+enum { RLJ_CRAFT_GUI = 0, RLJ_CRAFT_PRIMITIVE = 1 };
+
+/* RLJ_PLAYER_FLUID_STATE flags. `block` is normalized to 0, water (8), or
+ * lava (10). BODY is the same collision-volume material test player physics
+ * uses; VIEWPOINT is the exact near-plane eye test the renderer uses for
+ * fog; OVERLAY is its first-person water-overlay predicate. */
+enum {
+    RLJ_FLUID_BODY      = 1 << 0,
+    RLJ_FLUID_VIEWPOINT = 1 << 1,
+    RLJ_FLUID_OVERLAY   = 1 << 2
+};
+
+/* One record. 32 bytes, little-endian, no padding. */
+#pragma pack(push, 1)
+typedef struct {
+    unsigned short type;
+    unsigned short flags;   /* event-specific: broken/placed meta, fluid */
+    int tick;
+    int v[6];
+} RlJrnRec;
+
+/* Written once when the journal is armed, so a reader can refuse a
+ * stream it does not understand instead of misparsing it. */
+typedef struct {
+    unsigned magic;         /* "NRLJ" little-endian */
+    unsigned short version;
+    unsigned short rec_bytes;
+} RlJrnHead;
+#pragma pack(pop)
+
+#define RLJ_MAGIC   0x4a4c524eu
+/* Adding a typed event does not change the header or 32-byte record framing;
+ * version 1 is intentionally retained. */
+#define RLJ_VERSION 1
+
+/* Records buffered within ONE tick before the flush. The cap is not a
+ * tuning knob. The journal fd is a pipe and the harness drains it once
+ * per tick after reading that tick's observation, so at most one tick of
+ * records is ever in flight; a tick that could write more than the pipe
+ * buffer holds would block the engine mid-tick while the harness blocks
+ * reading the observation, and neither would ever wake. The cap makes
+ * that unreachable, and the dropped count is reported as RLJ_OVERFLOW
+ * rather than silently lost. */
+#define RLJ_MAX_PER_TICK 512
+
+/* Nonzero when a journal fd is armed. Exposed so the emit macro is one
+ * load and one predicate on the path of every engine tick. */
+extern int rlj_enabled;
+
+void rlj_emit_(int type, int a, int b, int c, int d, int e, int f);
+void rlj_emit_flags_(int type, unsigned flags,
+                     int a, int b, int c, int d, int e, int f);
+
+/* THE emit call. Every event type in the engine goes through this. */
+#define rlj_emit(t, a, b, c, d, e, f)                                    \
+    do {                                                                 \
+        if (rlj_enabled)                                                 \
+            rlj_emit_((t), (a), (b), (c), (d), (e), (f));                \
+    } while (0)
+
+/* The record header's existing flags field carries small event-specific
+ * state without changing the frozen 32-byte journal record. */
+#define rlj_emit_flags(t, flags, a, b, c, d, e, f)                       \
+    do {                                                                 \
+        if (rlj_enabled)                                                 \
+            rlj_emit_flags_((t), (unsigned)(flags),                      \
+                            (a), (b), (c), (d), (e), (f));               \
+    } while (0)
+
+/* Arm the journal from MAGMA_JOURNAL_FD and write the stream header.
+ * A no-op when the variable is unset, which is the default and costs
+ * nothing anywhere. */
+void rlj_open(void);
+
+/* Stamp this tick's records with `tick` and write them as ONE write().
+ * Called once per tick, after the tick and before the observation, so a
+ * reader that has just read observation N is guaranteed to already have
+ * every record for tick N waiting. */
+void rlj_flush(int tick);
+
+/* ---- edge-triggered samplers ---------------------------------------
+ * These turn per-tick quantities into sparse events. Most emit only on a
+ * change; state whose absence must not masquerade as proof emits one explicit
+ * baseline. Called once per emitted observation. */
+void rlj_sample_aim(int block, int dist_q4);
+void rlj_sample_path(double wx, double wz);
+void rlj_sample_vitals(int health, int food);
+#endif /* MAGMA_GAME_RL_JOURNAL_H */
