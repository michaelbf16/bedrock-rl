@@ -945,6 +945,12 @@ MC_HD static inline void cu_harvest_drop(int block_id, int block_meta, int tool_
         case 54: *item = 54; *count = 1; break; /* chest block item */
         case 56: *item = 264; *count = 1; break;
         case 129: *item = 388; *count = 1; break; /* emerald ore -> emerald */
+        case 73: case 74: {
+            u32 h = (u32)wx * 73428767u ^ (u32)wy * 912931u
