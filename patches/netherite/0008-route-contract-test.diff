diff --git a/magma/game/test_player_ctl.c b/magma/game/test_player_ctl.c
index 2713d01..d76d67a 100644
--- a/magma/game/test_player_ctl.c
+++ b/magma/game/test_player_ctl.c
@@ -184,7 +184,44 @@ int main(void)
     CHECK(isr_hotbar_total(&plb.inv) + isr_main_total(&plb.inv) == before_total,
           "break does not teleport its drop into inventory");
     CHECK(last_edit.drop_id == 4 && last_edit.drop_count == 1,
           "stone harvest emits one cobblestone item entity request");
+
+    /* The two vanilla log block IDs are distinct item IDs. Keep this live
+     * player path in lockstep with blaze/env/blaze_core.h: an acacia or dark
+     * oak trunk must never break successfully and silently emit drop zero. */
+    printf("case B2: log2 harvest emits its matching item and metadata\n");
+    fill_flat(win);
+    PsvPlayer log_player;
+    PvStats log_stats; pv_init(&log_stats);
+    spawn_at(&log_player, 24.5, 65.0, 24.5);
+    set_block_meta(win, 24, 64, 24, 162, 1);
+    isr_set_stack(&log_player.inv, 0, ic_mk(257 /* iron pick */, 1, 0));
+    log_player.inv.current_item = 0;
+    log_player.pitch = 89.0f;
+    gm_player_dig_reset();
+
+    GmAction log_break;
+    memset(&log_break, 0, sizeof log_break);
+    log_break.attack = 1;
+    GmBlockEdit log_edit = {0};
+    int log_saw_break = 0;
+    for (int t = 0; t < 200; ++t) {
+        GmBlockEdit edits[8];
+        int nedits = 0;
+        gm_player_tick((struct Chunk *)win, (struct McSinTable *)&st,
+                       (struct PsvPlayer *)&log_player,
+                       (struct PvStats *)&log_stats,
+                       log_break, 0, 0, 0, edits, &nedits, 8);
+        if (nedits == 1 && edits[0].id == 0) {
+            log_edit = edits[0];
+            log_saw_break = 1;
+            break;
+        }
+    }
+    CHECK(log_saw_break, "log2 block breaks through the live player path");
+    CHECK(log_edit.drop_id == 162 && log_edit.drop_count == 1 &&
+          log_edit.drop_meta == 1,
+          "log2 harvest emits one matching metadata-preserving item");
-
+
     /* ---------------- (C) UNDERWATER DIG PENALTY ---------------- */
     /* EntityPlayer.getDigSpeed: eye inside water without aqua affinity divides
@@ -735,6 +735,44 @@ int main(void)
               "live absorption stays 0 without vitals absorption field");
     }
 
+    /* ---- ItemBucket ray + journal state contract ------------------------- */
+    printf("case bucket-target: source, offsets, slot state, occlusion\n");
+    {
+        fill_flat(win);
+        PsvPlayer bucket;
+        spawn_at(&bucket, 24.5, 65.0, 24.5);
+        bucket.yaw = 0.0f; bucket.pitch = 0.0f; /* look toward +Z */
+        bucket.inv.current_item = 3;
+        isr_set_stack(&bucket.inv, 3, ic_mk(IC_BUCKET, 1, 0));
+        set_block_meta(win, 24, 66, 27, 9, 0); /* source water at eye ray */
+
+        GmBucketTarget bt;
+        gm_player_bucket_target_state(win, &st, &bucket, 1600, -3200, &bt);
+        CHECK(bt.block == 9 && bt.meta == 0,
+              "selected bucket reports metadata-zero water source");
+        CHECK(bt.wx == 1624 && bt.wy == 66 && bt.wz == -3173,
+              "bucket target exposes exact absolute source cell");
+        CHECK(bt.slot == 3, "bucket target exposes selected hotbar slot");
+
+        set_block_meta(win, 24, 66, 27, 9, 1); /* flowing water: transparent */
+        set_block_meta(win, 24, 66, 28, 11, 0); /* source lava behind it */
+        gm_player_bucket_target_state(win, &st, &bucket, 1600, -3200, &bt);
+        CHECK(bt.block == 11 && bt.wz == -3172,
+              "flowing liquid is transparent and source behind remains targetable");
+
+        set_block_meta(win, 24, 66, 26, 50, 3); /* wall torch intersects eye ray */
+        gm_player_bucket_target_state(win, &st, &bucket, 1600, -3200, &bt);
+        CHECK(bt.block == 0 && bt.slot == 3,
+              "selectable non-solid block occludes ItemBucket ray");
+
+        set_block_meta(win, 24, 66, 26, 0, 0);
+        isr_set_stack(&bucket.inv, 3, ic_mk(1, 1, 0));
+        gm_player_bucket_target_state(win, &st, &bucket, 1600, -3200, &bt);
+        CHECK(bt.block == 0 && bt.meta == 0 && bt.wx == 0 && bt.wy == 0 &&
+              bt.wz == 0 && bt.slot == -1,
+              "switching away publishes distinct inactive state with no stale target");
+    }
+
     printf(g_fail ? "\nRESULT: FAIL\n" : "\nRESULT: PASS (all cases)\n");
     free(win);
     return g_fail;
