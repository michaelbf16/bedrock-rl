+/* Rect of one slot id in the given container, or a zero-w rect if absent. */
+static GmScreenSlot slot_of(int container, int fb_w, int fb_h, int id)
+{
+    GmScreenSlot slots[GMC_SLOT_COUNT], none = {id, 0, 0, 0, 0};
+    int n = gm_screen_layout(container, fb_w, fb_h, slots, GMC_SLOT_COUNT);
+    for (int i = 0; i < n; ++i)
+        if (slots[i].slot_id == id) return slots[i];
+    return none;
+}
+
+/* Vanilla gui-space slot origin -> framebuffer, for the exact-coordinate
+ * checks below. Mirrors gm_screen_layout's panel_origin_h. */
+static void gui_to_fb(int fb_w, int fb_h, int gx, int gy, int *x, int *y)
+{
+    int s = fb_h / 240 > 1 ? fb_h / 240 : 1;
+    int gw = (fb_w + s - 1) / s, gh = (fb_h + s - 1) / s;
+    *x = (gw - 176) / 2 * s + gx * s;
+    *y = (gh - 166) / 2 * s + gy * s;
+}
+
+/* ContainerWorkbench: the 3x3 InventoryCrafting is ROW-MAJOR from (30,17)
+ * on an 18px pitch and the result is at (124,35). container_live ids 36..44
+ * must follow that order, because the Python demos and any GUI reward code
+ * address grid cells by id and click by pixel. */
+static void check_workbench_geometry(int fb_w, int fb_h)
+{
+    for (int i = 0; i < 9; ++i) {
+        GmScreenSlot sl = slot_of(1, fb_w, fb_h, GMC_GRID0 + i);
+        int wx, wy;
+        char msg[96];
+        gui_to_fb(fb_w, fb_h, 30 + (i % 3) * 18, 17 + (i / 3) * 18, &wx, &wy);
+        snprintf(msg, sizeof msg,
+                 "3x3 cell %d (id %d) is row-major from gui (30,17)",
+                 i, GMC_GRID0 + i);
+        CHECK(sl.w != 0 && sl.x == wx && sl.y == wy, msg);
+    }
+    { GmScreenSlot sl = slot_of(1, fb_w, fb_h, GMC_RESULT);
+      int wx, wy;
+      gui_to_fb(fb_w, fb_h, 124, 35, &wx, &wy);
+      CHECK(sl.w != 0 && sl.x == wx && sl.y == wy,
+            "workbench result sits at gui (124,35)"); }
+    /* the 2x2 player screen exposes only cells 0,1,3,4 of the same id space,
+     * so the five cells a table adds must be unreachable there */
+    { static const int only_3x3[5] = {2, 5, 6, 7, 8};   /* cells, not ids */
+      int missing = 1;
+      for (int k = 0; k < 5; ++k)
+          if (slot_of(0, fb_w, fb_h, GMC_GRID0 + only_3x3[k]).w != 0)
+              missing = 0;
+      CHECK(missing, "player screen exposes no 3x3-only grid cell"); }
+}
+
+/* ContainerFurnace: input (56,17), fuel (56,53), output (116,35). */
