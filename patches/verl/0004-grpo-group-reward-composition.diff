index 0000000000000000000000000000000000000000..7284e0ea36adc4944f55e58bb4d7accea4f37b58
--- /dev/null
+++ b/verl/trainer/ppo/reward_group_metrics.py
@@ -0,0 +1,137 @@
+# Copyright 2026 Bytedance Ltd. and/or its affiliates
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""Pure helpers for group-relative reward observability."""
+
+from collections import defaultdict
+from collections.abc import Hashable, Sequence
+from typing import Any
+
+
+ROLLOUT_EPISODE_SUCCESS_FIELD = "bedrock_rl_rollout_episode_success"
+
+
+def _composition_metrics(prefix: str, counts: dict[str, int]) -> dict[str, float | int]:
+    total = sum(counts.values())
+    metrics: dict[str, float | int] = {f"{prefix}/count": total}
+    for name, count in counts.items():
+        metrics[f"{prefix}/{name}/count"] = count
+        metrics[f"{prefix}/{name}/ratio"] = count / total if total else 0.0
+    return metrics
+
+
+def _per_sample_list(values: Any, field: str) -> list[Any]:
+    if hasattr(values, "tolist"):
+        values = values.tolist()
+    if not isinstance(values, (list, tuple)):
+        raise TypeError(f"{field} must be a one-dimensional per-sample sequence")
+    return list(values)
+
+
+def update_non_tensor_batch_with_reward_extra_info(
+    batch: Any,
+    reward_extra_info: dict[str, Any],
+) -> None:
+    """Merge reward metadata without overwriting rollout-owned outcomes."""
+    if ROLLOUT_EPISODE_SUCCESS_FIELD in reward_extra_info:
+        raise ValueError(
+            f"reward_extra_info cannot set rollout-owned field {ROLLOUT_EPISODE_SUCCESS_FIELD!r}"
+        )
+    batch.non_tensor_batch.update(reward_extra_info)
+
+
+def compute_grpo_group_reward_metrics(
+    sample_uids: Sequence[Hashable],
+    sequence_rewards: Sequence[float],
+    successes: Sequence[bool] | None = None,
+) -> dict[str, float | int]:
+    """Summarize the groups that GRPO will compare on one training step.
+
+    ``sequence_rewards`` must be the scalar rewards passed to GRPO after any
+    reward shaping or KL penalty. Reward composition is reported in terms of
+    zero versus nonzero within-group contrast; equal rewards do not imply
+    either success or failure.
+
+    Success composition is optional and is emitted only when the caller has
+    an authoritative, per-sample boolean. It is never inferred from rewards.
+    """
+    if len(sample_uids) != len(sequence_rewards):
+        raise ValueError("sample_uids and sequence_rewards must have the same length")
+    if successes is not None:
+        if len(successes) != len(sample_uids):
+            raise ValueError("successes and sample_uids must have the same length")
+        if any(type(success) is not bool for success in successes):
+            raise TypeError("successes must contain only authoritative booleans")
+
+    rewards_by_uid: dict[Any, list[float]] = defaultdict(list)
+    successes_by_uid: dict[Any, list[bool]] = defaultdict(list)
+    for sample_idx, (uid, reward) in enumerate(zip(sample_uids, sequence_rewards, strict=True)):
+        rewards_by_uid[uid].append(float(reward))
+        if successes is not None:
+            successes_by_uid[uid].append(successes[sample_idx])
+
+    contrasts = [max(rewards) - min(rewards) for rewards in rewards_by_uid.values()]
+    zero_contrast_count = sum(contrast == 0.0 for contrast in contrasts)
+    metrics = _composition_metrics(
+        "grpo/reward_group",
+        {
+            "zero_contrast": zero_contrast_count,
+            "nonzero_contrast": len(contrasts) - zero_contrast_count,
+        },
+    )
+    if contrasts:
+        metrics.update(
+            {
+                "grpo/reward_group/contrast/min": min(contrasts),
+                "grpo/reward_group/contrast/mean": sum(contrasts) / len(contrasts),
+                "grpo/reward_group/contrast/max": max(contrasts),
+            }
+        )
+
+    if successes is not None:
+        success_counts = {
+            "all_unsuccessful": 0,
+            "all_successful": 0,
+            "mixed": 0,
+        }
+        for group_successes in successes_by_uid.values():
+            if all(group_successes):
+                success_counts["all_successful"] += 1
+            elif any(group_successes):
+                success_counts["mixed"] += 1
+            else:
+                success_counts["all_unsuccessful"] += 1
+        metrics.update(_composition_metrics("grpo/success_group", success_counts))
+
+    return metrics
+
+
+def compute_grpo_group_reward_metrics_from_batch(batch: Any) -> dict[str, float | int]:
+    """Read the exact aligned arrays consumed by GRPO at its trainer boundary."""
+    sequence_rewards = (
+        batch.batch["token_level_rewards"].sum(dim=-1).detach().cpu().tolist()
+    )
+    sample_uids = _per_sample_list(batch.non_tensor_batch["uid"], "uid")
+
+    successes = None
+    if ROLLOUT_EPISODE_SUCCESS_FIELD in batch.non_tensor_batch:
+        successes = _per_sample_list(
+            batch.non_tensor_batch[ROLLOUT_EPISODE_SUCCESS_FIELD],
+            ROLLOUT_EPISODE_SUCCESS_FIELD,
+        )
+
+    return compute_grpo_group_reward_metrics(
+        sample_uids=sample_uids,
+        sequence_rewards=sequence_rewards,
+        successes=successes,
+    )
