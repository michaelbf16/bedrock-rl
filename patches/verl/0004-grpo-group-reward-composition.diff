+import ast
+import inspect
+import textwrap
+import unittest
+from types import SimpleNamespace
+
+import numpy as np
+import torch
+
+from verl.trainer.ppo import ray_trainer
+from verl.trainer.ppo.reward_group_metrics import ROLLOUT_EPISODE_SUCCESS_FIELD
+
+
+def _named_call(node, name):
+    return isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id == name
+
+
+def _grpo_guard(node):
+    return (
+        isinstance(node, ast.If)
+        and isinstance(node.test, ast.Compare)
+        and any(isinstance(op, ast.Eq) for op in node.test.ops)
+        and any(
+            isinstance(item, ast.Attribute)
+            and item.attr == "GRPO"
+            and isinstance(item.value, ast.Name)
+            and item.value.id == "AdvantageEstimator"
+            for item in ast.walk(node.test)
+        )
+    )
+
+
+class TestRayTrainerRewardGroupMetrics(unittest.TestCase):
+    def test_trainer_hook_executes_with_post_kl_globally_aligned_batch(self):
+        batch = SimpleNamespace(
+            batch={
+                # These pre-KL scores have zero contrast in both groups.
+                "token_level_scores": torch.tensor([
+                    [1.0, 0.0], [2.0, 0.0], [1.0, 0.0], [2.0, 0.0],
+                ]),
+                # The post-KL values consumed by GRPO have contrast for uid-a.
+                "token_level_rewards": torch.tensor([
+                    [0.0, 0.0], [0.5, 0.0], [1.0, 0.0], [0.5, 0.0],
+                ]),
+            },
+            non_tensor_batch={
+                # Noncontiguous siblings model the aligned global arrays after
+                # rollout repeat and token balancing.
+                "uid": np.array(["uid-a", "uid-b", "uid-a", "uid-b"], dtype=object),
+                ROLLOUT_EPISODE_SUCCESS_FIELD: np.array(
+                    [False, True, True, True], dtype=object
+                ),
+            },
+        )
+
+        metrics = ray_trainer.compute_grpo_group_metrics_for_batch(batch)
+
+        self.assertEqual(metrics["grpo/reward_group/zero_contrast/count"], 1)
+        self.assertEqual(metrics["grpo/reward_group/nonzero_contrast/count"], 1)
+        self.assertEqual(metrics["grpo/reward_group/contrast/max"], 1.0)
+        self.assertEqual(metrics["grpo/success_group/mixed/count"], 1)
+        self.assertEqual(metrics["grpo/success_group/all_successful/count"], 1)
+
+    def test_fit_calls_hook_in_grpo_guard_immediately_before_advantage(self):
+        tree = ast.parse(textwrap.dedent(inspect.getsource(ray_trainer.RayPPOTrainer.fit)))
+        function = tree.body[0]
+        self.assertIsInstance(function, (ast.FunctionDef, ast.AsyncFunctionDef))
+
+        matches = []
+        for parent in ast.walk(function):
+            for _, statements in ast.iter_fields(parent):
+                if not isinstance(statements, list):
+                    continue
+                for index, statement in enumerate(statements[:-1]):
+                    if not _grpo_guard(statement):
+                        continue
+                    matches.append((statement, statements[index + 1]))
+
+        self.assertEqual(len(matches), 1, "expected one explicit GRPO metrics guard")
+        guard, next_statement = matches[0]
+        self.assertEqual(len(guard.body), 1)
+
+        update_statement = guard.body[0]
+        self.assertIsInstance(update_statement, ast.Expr)
+        update_call = update_statement.value
+        self.assertIsInstance(update_call, ast.Call)
+        self.assertIsInstance(update_call.func, ast.Attribute)
+        self.assertEqual(update_call.func.attr, "update")
+        self.assertEqual(len(update_call.args), 1)
+        hook_call = update_call.args[0]
+        self.assertTrue(_named_call(hook_call, "compute_grpo_group_metrics_for_batch"))
+        self.assertEqual(len(hook_call.args), 1)
+        self.assertIsInstance(hook_call.args[0], ast.Name)
+        self.assertEqual(hook_call.args[0].id, "batch")
+
+        self.assertIsInstance(next_statement, ast.Assign)
+        self.assertTrue(_named_call(next_statement.value, "compute_advantage"))
+
+
+if __name__ == "__main__":
+    unittest.main()
