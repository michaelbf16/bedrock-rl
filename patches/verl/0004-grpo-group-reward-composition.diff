+import unittest
+
+from verl.trainer.ppo.reward_group_metrics import (
+    ROLLOUT_EPISODE_SUCCESS_FIELD,
+    compute_grpo_group_reward_metrics,
+    compute_grpo_group_reward_metrics_from_batch,
+    update_non_tensor_batch_with_reward_extra_info,
+)
+
+
+class _Array:
+    def __init__(self, values):
+        self.values = values
+
+    def detach(self):
+        return self
+
+    def cpu(self):
+        return self
+
+    def tolist(self):
+        return self.values
+
+
+class _SequenceRewardTensor:
+    """Tiny torch-shaped value used to keep this helper suite dependency-free."""
+
+    def __init__(self, token_rewards):
+        self.token_rewards = token_rewards
+        self.sum_dim = None
+
+    def sum(self, dim):
+        self.sum_dim = dim
+        return _Array([sum(row) for row in self.token_rewards])
+
+    def detach(self):
+        return self
+
+    def cpu(self):
+        return self
+
+
+class _Batch:
+    def __init__(self, token_scores, token_rewards, uids, **non_tensor_batch):
+        self.rewards = _SequenceRewardTensor(token_rewards)
+        self.batch = {
+            "token_level_scores": token_scores,
+            "token_level_rewards": self.rewards,
+        }
+        self.non_tensor_batch = {"uid": _Array(uids), **non_tensor_batch}
+
+
+class TestGrpoGroupRewardMetrics(unittest.TestCase):
+    def test_reward_contrast_and_authoritative_success_composition(self):
+        metrics = compute_grpo_group_reward_metrics(
+            sample_uids=["mixed", "mixed", "miss", "miss", "pass", "pass"],
+            sequence_rewards=[-1.0, 1.0, 0.0, 0.0, 2.0, 2.0],
+            successes=[False, True, False, False, True, True],
+        )
+
+        self.assertEqual(metrics["grpo/reward_group/count"], 3)
+        self.assertEqual(metrics["grpo/reward_group/zero_contrast/count"], 2)
+        self.assertEqual(metrics["grpo/reward_group/nonzero_contrast/count"], 1)
+        self.assertAlmostEqual(metrics["grpo/reward_group/zero_contrast/ratio"], 2 / 3)
+        self.assertAlmostEqual(metrics["grpo/reward_group/contrast/mean"], 2 / 3)
+        self.assertEqual(metrics["grpo/success_group/all_unsuccessful/count"], 1)
+        self.assertEqual(metrics["grpo/success_group/all_successful/count"], 1)
+        self.assertEqual(metrics["grpo/success_group/mixed/count"], 1)
+
+    def test_equal_rewards_do_not_imply_success_composition(self):
+        metrics = compute_grpo_group_reward_metrics(
+            sample_uids=["group", "group"],
+            sequence_rewards=[0.25, 0.25],
+        )
+
+        self.assertEqual(metrics["grpo/reward_group/zero_contrast/count"], 1)
+        self.assertFalse(any(key.startswith("grpo/success_group/") for key in metrics))
+
+    def test_equal_rewards_can_have_mixed_authoritative_success(self):
+        metrics = compute_grpo_group_reward_metrics(
+            sample_uids=["group", "group"],
+            sequence_rewards=[0.25, 0.25],
+            successes=[False, True],
+        )
+
+        self.assertEqual(metrics["grpo/reward_group/zero_contrast/count"], 1)
+        self.assertEqual(metrics["grpo/success_group/mixed/count"], 1)
+
+    def test_rejects_non_boolean_success_values(self):
+        with self.assertRaisesRegex(TypeError, "authoritative booleans"):
+            compute_grpo_group_reward_metrics(
+                sample_uids=["group"],
+                sequence_rewards=[1.0],
+                successes=[1],
+            )
+
+    def test_trainer_hook_uses_post_kl_rewards_and_aligned_namespaced_fields(self):
+        batch = _Batch(
+            # Pre-KL scores have zero contrast in both groups. The post-KL
+            # rewards below deliberately have contrast only for uid-a.
+            token_scores=[[1.0], [2.0], [1.0], [2.0]],
+            token_rewards=[[0.0, 0.0], [0.5, 0.0], [1.0, 0.0], [0.5, 0.0]],
+            # Noncontiguous order models the globally aligned arrays after
+            # repeat and balance operations.
+            uids=["uid-a", "uid-b", "uid-a", "uid-b"],
+            success=_Array([True, True, True, True]),
+            **{ROLLOUT_EPISODE_SUCCESS_FIELD: _Array([False, True, True, True])},
+        )
+
+        metrics = compute_grpo_group_reward_metrics_from_batch(batch)
+
+        self.assertEqual(batch.rewards.sum_dim, -1)
+        self.assertEqual(metrics["grpo/reward_group/zero_contrast/count"], 1)
+        self.assertEqual(metrics["grpo/reward_group/nonzero_contrast/count"], 1)
+        self.assertEqual(metrics["grpo/reward_group/contrast/max"], 1.0)
+        self.assertEqual(metrics["grpo/success_group/mixed/count"], 1)
+        self.assertEqual(metrics["grpo/success_group/all_successful/count"], 1)
+
+    def test_trainer_hook_ignores_generic_success_and_fails_closed_on_bad_namespace(self):
+        generic_only = _Batch(
+            token_scores=[[0.0], [0.0]],
+            token_rewards=[[0.0], [0.0]],
+            uids=["uid", "uid"],
+            success=_Array([False, False]),
+        )
+        metrics = compute_grpo_group_reward_metrics_from_batch(generic_only)
+        self.assertFalse(any(key.startswith("grpo/success_group/") for key in metrics))
+
+        malformed = _Batch(
+            token_scores=[[0.0], [0.0]],
+            token_rewards=[[0.0], [0.0]],
+            uids=["uid", "uid"],
+            **{ROLLOUT_EPISODE_SUCCESS_FIELD: _Array([False, 1])},
+        )
+        with self.assertRaisesRegex(TypeError, "authoritative booleans"):
+            compute_grpo_group_reward_metrics_from_batch(malformed)
+
+        misaligned = _Batch(
+            token_scores=[[0.0], [0.0]],
+            token_rewards=[[0.0], [0.0]],
+            uids=["uid", "uid"],
+            **{ROLLOUT_EPISODE_SUCCESS_FIELD: _Array([False])},
+        )
+        with self.assertRaisesRegex(ValueError, "same length"):
+            compute_grpo_group_reward_metrics_from_batch(misaligned)
+
+    def test_reward_extra_info_cannot_overwrite_rollout_outcomes(self):
+        batch = _Batch(
+            token_scores=[[0.0]],
+            token_rewards=[[0.0]],
+            uids=["uid"],
+            **{ROLLOUT_EPISODE_SUCCESS_FIELD: _Array([True])},
+        )
+
+        with self.assertRaisesRegex(ValueError, "rollout-owned field"):
+            update_non_tensor_batch_with_reward_extra_info(
+                batch,
+                {ROLLOUT_EPISODE_SUCCESS_FIELD: _Array([False])},
+            )
+        self.assertEqual(
+            batch.non_tensor_batch[ROLLOUT_EPISODE_SUCCESS_FIELD].tolist(),
+            [True],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
